// The shared transform is patched in as its own top-level attribute rather than as a member of
// immersiveBackpackAttachment: that is where vanilla's Transform Editor stores it, so it can be tuned with
// /tfedit and written straight back here. Two entries per item is the price.
[
	{
		"op": "add",
		"path": "/attributes/immersiveBackpackAttachment",
		"value": { "category": "sack" },
		"file": "game:itemtypes/wearable/bag/linensack.json"
	},
	{
		"op": "add",
		"path": "/attributes/immersiveAttachedTransform",
		"value": { "scale": 0.45 },
		"file": "game:itemtypes/wearable/bag/linensack.json"
	},
	{
