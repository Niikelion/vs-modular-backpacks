<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Unique assembly name: must differ from Deven's "Immersive Backpacks" mod, whose DLL is also
             ImmersiveBackpacks - VS loads mod assemblies by simple name and rejects a duplicate. -->
        <AssemblyName>ImmersiveModularBackpacks</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Folder name, not modid, is what Vintage Story keys a folder mod by: two mods both built into a
             folder called "mod" crash mod loading ("An item with the same key has already been added"). Name
             it after the modid so this output can be added as a mod path alongside any other mod's. -->
        <OutputPath>bin\$(Configuration)\Mods\immersivemodularbackpacks</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="VintagestoryAPI">
            <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="VSSurvivalMod">
            <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VSEssentials">
            <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VintagestoryLib">
            <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Cairo: the GUI drawing surface every RichTextComponent composes onto (ComposeElements). -->
        <Reference Include="cairo-sharp">
            <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Soft dependency: compile against PlayerModelLib to integrate its worn-gear pipeline on custom
             player models. NOT shipped (Private=false); provided at runtime by the playermodellib mod when
             installed. All use is gated behind a ShouldLoad(IsModEnabled) ModSystem so absence is safe. -->
        <Reference Include="PlayerModelLib">
            <HintPath>lib/PlayerModelLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="OverhaulLib">
            <HintPath>lib/OverhaulLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Dev-only: when the VSMCP agent bridge has been built next to this repo, compile the integration-test
         seam (src/compat/BridgeActions.cs) against it. Absent - on CI, or for anyone without the bridge - the
         reference and the file both disappear, so nothing about the shipped mod changes. Private=false keeps
         VSMCP.dll out of our output; the game loads it as its own mod.
         Deliberately the built DLL rather than a ProjectReference: a sibling repo mid-edit would otherwise
         break this build. Override with -p:VsmcpDll=<path>. -->
    <PropertyGroup>
        <VsmcpDll Condition="'$(VsmcpDll)' == ''">$(MSBuildThisFileDirectory)..\..\VSMCP\VSMCP\bin\Debug\Mods\mod\VSMCP.dll</VsmcpDll>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(VsmcpDll)')">
        <DefineConstants>$(DefineConstants);VSMCP_BRIDGE</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(VsmcpDll)')">
        <Reference Include="VSMCP">
            <HintPath>$(VsmcpDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="modinfo.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="worldconfig.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="assets\immersivemodularbackpacks\shapes\item\bag\" />
    </ItemGroup>

</Project>
