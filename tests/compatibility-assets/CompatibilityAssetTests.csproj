<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll" Private="true" />
    <Reference Include="Tavis.JsonPatch" HintPath="$(VINTAGE_STORY)/Lib/Tavis.JsonPatch.dll" Private="true" />
    <None Include="../../ImmersiveBackpacks/assets/immersivemodularbackpacks/patches/*.json"
          Link="patches/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImmersiveBackpacks/assets/immersivemodularbackpacks/itemtypes/toolstrap.json"
          Link="toolstrap.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
